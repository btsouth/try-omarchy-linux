From 629e42166b5813cdbe2d04c4196d2bb24bbef9e6 Mon Sep 17 00:00:00 2001
From: Try Omarchy Release <actions@users.noreply.github.com>
Date: Sat, 26 Sep 2026 11:11:49 -0400
Subject: [PATCH 103/107] Present Vulkan windows through CPU copies when the
 launcher asks

A Linux host whose only GPU is NVIDIA shears Venus frames: its GL reads imported LINEAR dma-bufs at align(width * 4, 32) whatever pitch they were imported with. The Linux launcher passes tryomarchy.vulkan-present=cpu on such hosts, and vulkan-env then adds sw to MESA_VK_WSI_DEBUG so Mesa copies each frame into shared memory. Windows launchers never pass the flag. Compatibility revision 40 delivers the updated vulkan-env to existing disks.
---
 .../usr/local/lib/try-omarchy/vulkan-env      | 14 +++++++++++++
 guest/scripts/finalize-rootfs.sh              |  3 ++-
 guest/tests/test_vulkan_env.py                | 21 +++++++++++++++++++
 guest/tests/verify.py                         |  2 +-
 4 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/vulkan-env b/guest/factory-overlay/usr/local/lib/try-omarchy/vulkan-env
index 7a82b59..a0376d9 100644
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/vulkan-env
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/vulkan-env
@@ -12,3 +12,17 @@ export VN_PERF
 # Use the loader's supported option, without globally preloading a Vulkan ICD.
 : "${VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING:=1}"
 export VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING
+
+# A Linux host whose only GPU is NVIDIA misreads the row pitch of the Vulkan
+# frames it imports and shears them, so its launcher asks for software
+# presentation on the kernel command line: Mesa copies each frame into shared
+# memory instead. Preserve additional user-selected WSI debug flags.
+case " $(cat "${TRY_OMARCHY_CMDLINE:-/proc/cmdline}" 2>/dev/null) " in
+  *" tryomarchy.vulkan-present=cpu "*)
+    case ",${MESA_VK_WSI_DEBUG-}," in
+      *,sw,*) ;;
+      *) MESA_VK_WSI_DEBUG="${MESA_VK_WSI_DEBUG:+${MESA_VK_WSI_DEBUG},}sw" ;;
+    esac
+    export MESA_VK_WSI_DEBUG
+    ;;
+esac
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index c8010fc..fb91358 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -197,7 +197,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 38 drags dropped files into the app under the pointer.
 # Revision 39 hardens the Windows Hello broker and 1Password agent, checks the
 # drop overlay is mapped before dragging, and records reload modes per display.
-compat_revision=39
+# Revision 40 lets a Linux launcher ask for CPU presentation of Vulkan windows.
+compat_revision=40
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
diff --git a/guest/tests/test_vulkan_env.py b/guest/tests/test_vulkan_env.py
index 31c9aba..ae02b38 100644
--- a/guest/tests/test_vulkan_env.py
+++ b/guest/tests/test_vulkan_env.py
@@ -1,6 +1,7 @@
 import os
 from pathlib import Path
 import subprocess
+import tempfile
 import unittest
 
 
@@ -8,6 +9,26 @@ SCRIPT = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/lib/tr
 
 
 class VulkanEnvironmentTests(unittest.TestCase):
+    def presentation(self, cmdline, **values):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / 'cmdline'
+            path.write_text(cmdline + '\n')
+            env = dict(os.environ)
+            env.pop('MESA_VK_WSI_DEBUG', None)
+            env.update(values, TRY_OMARCHY_CMDLINE=str(path))
+            command = '. "$1"; . "$1"; printf "%s\n" "${MESA_VK_WSI_DEBUG-unset}"'
+            return subprocess.check_output(['sh', '-c', command, 'test', str(SCRIPT)], env=env, text=True).strip()
+
+    def test_cpu_presentation_only_when_the_launcher_asks(self):
+        self.assertEqual(self.presentation('root=/dev/vda tryomarchy.vulkan-present=cpu quiet'), 'sw')
+        self.assertEqual(self.presentation('root=/dev/vda tryomarchy.vulkan-present=cpu'), 'sw')
+        self.assertEqual(self.presentation('root=/dev/vda tryomarchy.vulkan-present=gpu quiet'), 'unset')
+        self.assertEqual(self.presentation('root=/dev/vda xtryomarchy.vulkan-present=cpu'), 'unset')
+
+    def test_cpu_presentation_keeps_other_wsi_flags(self):
+        self.assertEqual(self.presentation('tryomarchy.vulkan-present=cpu', MESA_VK_WSI_DEBUG='linear'), 'linear,sw')
+        self.assertEqual(self.presentation('tryomarchy.vulkan-present=cpu', MESA_VK_WSI_DEBUG='sw,linear'), 'sw,linear')
+
     def environment(self, **values):
         env = dict(os.environ)
         for key in ('VN_PERF', 'VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING'):
diff --git a/guest/tests/verify.py b/guest/tests/verify.py
index 3c4d59d..a8e7ed7 100755
--- a/guest/tests/verify.py
+++ b/guest/tests/verify.py
@@ -278,7 +278,7 @@ def main() -> None:
     finalize_rootfs = read(GUEST / "scripts/finalize-rootfs.sh")
     compat_paths = finalize_rootfs.split("compat_paths=(", 1)[1].split(")", 1)[0]
     check(
-        "compat_revision=39" in finalize_rootfs
+        "compat_revision=40" in finalize_rootfs
         and "usr/local/lib/try-omarchy/catch-up" in compat_paths
         and "usr/local/bin/omarchy-native-display-sync" in compat_paths
         and "usr/local/bin/omarchy-windows-audio-bridge" in compat_paths
