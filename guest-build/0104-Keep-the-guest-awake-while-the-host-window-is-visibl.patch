diff --git a/guest/tests/test_host_window.py b/guest/tests/test_host_window.py
new file mode 100644
index 0000000..744dfed
--- /dev/null
+++ b/guest/tests/test_host_window.py
@@ -0,0 +1,30 @@
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+HELPER = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/lib/try-omarchy/host-window'
+AGENT = HELPER.with_name('agent')
+
+class HostWindowTest(unittest.TestCase):
+    def test_lease_expiry_release_and_invalid_input(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            lease, uptime = root / 'lease', root / 'uptime'
+            env = dict(os.environ, TRY_OMARCHY_WINDOW_LEASE=str(lease), TRY_OMARCHY_UPTIME_FILE=str(uptime), TRY_OMARCHY_WINDOW_HELPER=str(HELPER))
+            def active(at):
+                uptime.write_text(f'{at}.00 0.00\n')
+                return subprocess.check_output([str(HELPER), 'active'], env=env, text=True).strip()
+            self.assertEqual(active(100), 'false')
+            subprocess.run([str(AGENT), '--handle'], input='host-window visible\n', text=True, env=env, check=True)
+            self.assertEqual(active(119), 'true')
+            self.assertEqual(active(120), 'false')
+            self.assertEqual(active(90), 'false')
+            for invalid in ['garbage', '-1', '99999999999999', '1+1000', '9999999999']:
+                lease.write_text(invalid + '\n')
+                self.assertEqual(active(100), 'false')
+            subprocess.run([str(AGENT), '--handle'], input='host-window visible\nhost-window hidden\n', text=True, env=env, check=True)
+            self.assertFalse(lease.exists())
+            subprocess.run([str(AGENT), '--handle'], input='host-window visible; touch BAD\n', text=True, env=env, check=True)
+            self.assertFalse(lease.exists())
