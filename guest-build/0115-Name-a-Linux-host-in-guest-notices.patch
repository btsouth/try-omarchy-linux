diff --git a/guest/tests/test_file_drop_target.py b/guest/tests/test_file_drop_target.py
index 917d337..41f9844 100644
--- a/guest/tests/test_file_drop_target.py
+++ b/guest/tests/test_file_drop_target.py
@@ -93,6 +93,21 @@ class DropTargetTests(unittest.TestCase):
     def test_a_refused_app_drag_still_reports_downloads(self):
         self.receive_onto_app(False).assert_called_once_with('Files saved to Downloads', '1 item(s) received from Windows.')
 
+    def test_notices_name_a_linux_host(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cmdline = Path(tmp) / 'cmdline'
+            for words, name in (('root=/dev/vda rw tryomarchy.host=linux quiet', 'the host computer'),
+                                ('root=/dev/vda rw', 'Windows')):
+                cmdline.write_text(words + '\n')
+                with patch.dict(os.environ, {'TRY_OMARCHY_CMDLINE': str(cmdline)}):
+                    self.assertEqual(module.host_name(), name)
+            with patch.dict(os.environ, {'TRY_OMARCHY_CMDLINE': str(Path(tmp) / 'missing')}):
+                self.assertEqual(module.host_name(), 'Windows')
+            cmdline.write_text('tryomarchy.host=linux\n')
+            with patch.dict(os.environ, {'TRY_OMARCHY_CMDLINE': str(cmdline)}):
+                self.receive_onto_app(False).assert_called_once_with(
+                    'Files saved to Downloads', '1 item(s) received from the host computer.')
+
     def test_tablet_position_follows_scale_and_monitor_size(self):
         monitor = {'width': 2560, 'height': 1440, 'scale': 2, 'x': 0, 'y': 0}
         self.assertEqual(module.tablet_position(0, 0, monitor), (0, 0))
diff --git a/guest/tests/test_overlay_scripts.py b/guest/tests/test_overlay_scripts.py
