@@ -463,6 +463,23 @@ class AgentTests(OverlayCase):
                 self.assertEqual(received.result(timeout=5), f"launch-app {app_id}\n".encode())
                 self.assertEqual(result.returncode, 1)
 
+    def test_host_settings_names_a_linux_host(self) -> None:
+        cmdline = self.root / "cmdline"
+        with socket.socket() as server:
+            server.bind(("127.0.0.1", 0))
+            port = server.getsockname()[1]
+        for words, message in (("root=/dev/vda rw tryomarchy.host=linux quiet", "Try Omarchy on the host computer"),
+                               ("root=/dev/vda rw tryomarchy.host=linuxish", "Start Omarchy from Windows")):
+            with self.subTest(words=words):
+                cmdline.write_text(words + "\n")
+                env = dict(self.env, TRY_OMARCHY_AGENT_HOST="127.0.0.1", TRY_OMARCHY_AGENT_PORT=str(port),
+                           TRY_OMARCHY_CMDLINE=str(cmdline))
+                result = subprocess.run([str(HOST_SETTINGS)], env=env, capture_output=True, text=True, timeout=10)
+                self.assertEqual(result.returncode, 1)
+                self.assertIn(message, result.stderr)
+        desktop = (OVERLAY / "usr/share/applications/try-omarchy-host-settings.desktop").read_text()
+        self.assertNotIn("Windows", desktop)
+
     def test_host_settings_request_and_failure(self) -> None:
         with socket.socket() as server:
             server.bind(("127.0.0.1", 0))
