 guest/tests/verify.py                           |  2 +-
 9 files changed, 75 insertions(+), 13 deletions(-)

diff --git a/guest/factory-overlay/usr/local/bin/file-transfer-window b/guest/factory-overlay/usr/local/bin/file-transfer-window
index 23686d2..ee1ab91 100755
--- a/guest/factory-overlay/usr/local/bin/file-transfer-window
+++ b/guest/factory-overlay/usr/local/bin/file-transfer-window
@@ -13,6 +13,15 @@ gi.require_version('Gdk', '4.0')
 from gi.repository import Gdk, Gio, GLib, Gtk
 
 
+def host_name():
+    '''Windows, unless the Linux launcher names itself on the kernel command line.'''
+    try:
+        words = Path(os.environ.get('TRY_OMARCHY_CMDLINE', '/proc/cmdline')).read_text().split()
+    except OSError:
+        return 'Windows'
+    return 'the host computer' if 'tryomarchy.host=linux' in words else 'Windows'
+
+
 class Transfers(Gtk.Application):
     def __init__(self):
         super().__init__(application_id='org.omarchy.FileTransfers', flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
@@ -65,9 +74,9 @@ class Transfers(Gtk.Application):
         if self.window:
             self.window.present()
             return
-        self.window = Gtk.ApplicationWindow(application=self, title='Files between Windows and Omarchy', default_width=560, default_height=400)
+        self.window = Gtk.ApplicationWindow(application=self, title=f'Files between {host_name()} and Omarchy', default_width=560, default_height=400)
         box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=20, margin_bottom=20, margin_start=20, margin_end=20)
-        box.append(Gtk.Label(label='Drop files here to send them to Windows.\nDrag received files below into Files or another application.', wrap=True))
+        box.append(Gtk.Label(label=f'Drop files here to send them to {host_name()}.\nDrag received files below into Files or another application.', wrap=True))
         target = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
         target.connect('drop', self.drop)
         box.add_controller(target)
@@ -90,7 +99,7 @@ class Transfers(Gtk.Application):
             self.window.present()
 
     def choose(self, *_):
-        dialog = Gtk.FileDialog(title='Send files to Windows')
+        dialog = Gtk.FileDialog(title=f'Send files to {host_name()}')
         def selected(dialog, result):
             try:
                 files = dialog.open_multiple_finish(result)
