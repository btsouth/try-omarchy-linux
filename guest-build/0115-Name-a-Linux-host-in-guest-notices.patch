diff --git a/guest/factory-overlay/usr/local/bin/try-omarchy-host-settings b/guest/factory-overlay/usr/local/bin/try-omarchy-host-settings
index ee5804a..1f5fe7e 100755
--- a/guest/factory-overlay/usr/local/bin/try-omarchy-host-settings
+++ b/guest/factory-overlay/usr/local/bin/try-omarchy-host-settings
@@ -1,12 +1,22 @@
 #!/bin/bash
-# Open the native Windows settings window through the local host agent.
+# Open the host's Try Omarchy settings window through the local host agent.
+# The host is Windows unless the Linux launcher names itself on the kernel
+# command line.
 set -u
+unavailable='Try Omarchy settings are unavailable. Start Omarchy from Windows and try again.'
+refused='Could not open Try Omarchy settings on Windows.'
+case " $(cat "${TRY_OMARCHY_CMDLINE:-/proc/cmdline}" 2>/dev/null) " in
+  *" tryomarchy.host=linux "*)
+    unavailable='Try Omarchy settings are unavailable. Start Omarchy from Try Omarchy on the host computer and try again.'
+    refused='Could not open Try Omarchy settings on the host computer.'
+    ;;
+esac
 host=${TRY_OMARCHY_AGENT_HOST:-10.0.2.2}
 port=${TRY_OMARCHY_AGENT_PORT:-4451}
 if ! { exec 3<>"/dev/tcp/$host/$port"; } 2>/dev/null; then
-  message='Try Omarchy settings are unavailable. Start Omarchy from Windows and try again.'
+  message=$unavailable
 elif ! printf 'open-settings\n' >&3 || ! IFS= read -r -t 5 response <&3 || [[ $response != ok ]]; then
-  message='Could not open Try Omarchy settings on Windows.'
+  message=$refused
 else
   exec 3>&-
   exit 0
