 .../usr/local/bin/try-omarchy-drop              | 14 ++++++++++++--
 .../usr/local/bin/try-omarchy-host-settings     | 16 +++++++++++++---
 .../try-omarchy-file-transfers.desktop          |  4 ++--
 .../try-omarchy-host-settings.desktop           |  2 +-
 guest/scripts/finalize-rootfs.sh                |  3 ++-
