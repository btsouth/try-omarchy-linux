--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/repair-clock-timezone
@@ -0,0 +1,15 @@
+#!/bin/bash
+# Repair only the clock widget shipped by earlier Try Omarchy images, so a
+# followed host time zone shows without restarting the shell. An Omarchy
+# upgrade or a user's edit must never be replaced with an older file.
+set -euo pipefail
+path=${TRY_OMARCHY_CLOCK_WIDGET:-/usr/share/omarchy/shell/plugins/panels/clock/BarWidget.qml}
+replacement=${TRY_OMARCHY_CLOCK_REPLACEMENT:-/usr/share/try-omarchy/clock-timezone-refresh.qml}
+[[ -f $path && -f $replacement && ! -L $path ]] || exit 0
+read -r digest _ < <(sha256sum "$path")
+case $digest in
+  cfcdaeedc4ae5832b37271a84bb92ee762301022e2443a0f769992fa792acf28)
+    install -m 0644 "$replacement" "$path.try-omarchy"
+    mv -f -- "$path.try-omarchy" "$path"
+    ;;
+esac
