diff --git a/guest/tests/test_timezone.py b/guest/tests/test_timezone.py
index 6560b66..5d12945 100644
--- a/guest/tests/test_timezone.py
+++ b/guest/tests/test_timezone.py
@@ -137,3 +137,58 @@ class TimeZoneTests(unittest.TestCase):
 
 if __name__ == '__main__':
     unittest.main()
+
+
+class ClockRepairTests(unittest.TestCase):
+    """Disks that receive revision 48 also get the clock's time-zone refresh."""
+    REPAIR = GUEST / 'factory-overlay/usr/local/lib/try-omarchy/repair-clock-timezone'
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        root = Path(self.tmp.name)
+        self.widget = root / 'BarWidget.qml'
+        self.replacement = root / 'clock-timezone-refresh.qml'
+        self.replacement.write_text('patched\n')
+        self.env = dict(os.environ, TRY_OMARCHY_CLOCK_WIDGET=str(self.widget), TRY_OMARCHY_CLOCK_REPLACEMENT=str(self.replacement))
+        self.shipped = self.shipped_widget()
+
+    def shipped_widget(self):
+        """The digest of the unpatched widget that earlier images installed."""
+        spec = json.loads((GUEST / 'spec.json').read_text())
+        backport = next(b for b in spec['authenticity']['backports'] if b['id'] == 'clock-timezone-refresh')
+        return backport['targets'][0]['beforeSha256']
+
+    def repair(self):
+        subprocess.run([str(self.REPAIR)], env=self.env, check=True)
+
+    def test_repairs_only_the_shipped_widget(self):
+        script = self.REPAIR.read_text()
+        self.assertIn(self.shipped, script)
+        # An edited or newer widget is left alone.
+        self.widget.write_text('user edit\n')
+        self.repair()
+        self.assertEqual(self.widget.read_text(), 'user edit\n')
+        # A symlink is never followed.
+        self.widget.unlink()
+        target = Path(self.tmp.name) / 'elsewhere.qml'
+        target.write_text('user edit\n')
+        self.widget.symlink_to(target)
+        self.repair()
+        self.assertTrue(self.widget.is_symlink())
+        self.assertEqual(target.read_text(), 'user edit\n')
+        # A missing widget or replacement is not an error.
+        self.widget.unlink()
+        self.repair()
+        self.assertFalse(self.widget.exists())
+
+    def test_replaces_a_widget_with_the_shipped_digest(self):
+        fake = Path(self.tmp.name) / 'bin'
+        fake.mkdir()
+        (fake / 'sha256sum').write_text(f'#!/bin/sh\necho "{self.shipped}  $1"\n')
+        (fake / 'sha256sum').chmod(0o755)
+        self.widget.write_text('shipped\n')
+        env = dict(self.env, PATH=f'{fake}:{os.environ["PATH"]}')
+        subprocess.run([str(self.REPAIR)], env=env, check=True)
+        self.assertEqual(self.widget.read_text(), 'patched\n')
+        self.assertFalse(self.widget.with_name('BarWidget.qml.try-omarchy').exists())
