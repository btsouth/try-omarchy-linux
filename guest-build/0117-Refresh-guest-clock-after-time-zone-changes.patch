+++ b/guest/patches/omarchy/clock-timezone-refresh.patch
@@ -0,0 +1,11 @@
+diff --git a/shell/plugins/panels/clock/BarWidget.qml b/shell/plugins/panels/clock/BarWidget.qml
+--- a/shell/plugins/panels/clock/BarWidget.qml
++++ b/shell/plugins/panels/clock/BarWidget.qml
+@@ -32,6 +32,7 @@
+   readonly property var verticalLines: displayText.split("\n")
+ 
+   function refresh() {
++    Date.timeZoneUpdated()
+     displayDate = new Date()
+     if (panelLoader.item && panelLoader.item.refresh) panelLoader.item.refresh()
+   }
