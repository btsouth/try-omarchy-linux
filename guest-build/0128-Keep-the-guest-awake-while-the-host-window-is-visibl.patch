diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/host-window b/guest/factory-overlay/usr/local/lib/try-omarchy/host-window
new file mode 100755
index 0000000..23c6169
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/host-window
@@ -0,0 +1,31 @@
+#!/bin/bash
+# A renewable idle inhibitor, independent of the user's stay-awake preference.
+# /proc/uptime is monotonic across wall-clock synchronization and suspend.
+set -euo pipefail
+case " $(cat "${TRY_OMARCHY_CMDLINE:-/proc/cmdline}" 2>/dev/null) " in
+  *" tryomarchy.host=linux "*) ;;
+  *) [[ ${1:-} != active ]] || echo false; exit 0 ;;
+esac
+lease=${TRY_OMARCHY_WINDOW_LEASE:-/run/try-omarchy-host-window}
+uptime_file=${TRY_OMARCHY_UPTIME_FILE:-/proc/uptime}
+read -r uptime _ < "$uptime_file"
+now=${uptime%%.*}
+[[ $now =~ ^[0-9]{1,10}$ ]] || exit 1
+case ${1:-} in
+  visible)
+    umask 022
+    printf '%s\n' "$((10#$now + 20))" > "$lease.part"
+    mv -f -- "$lease.part" "$lease"
+    ;;
+  hidden) rm -f -- "$lease" "$lease.part" ;;
+  active)
+    expires=0
+    if [[ -f $lease ]]; then read -r expires < "$lease" || expires=0; fi
+    if [[ $expires =~ ^[0-9]{1,10}$ ]] && ((10#$expires > 10#$now && 10#$expires <= 10#$now + 20)); then
+      echo true
+    else
+      echo false
+    fi
+    ;;
+  *) exit 2 ;;
+esac
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/repair-host-window b/guest/factory-overlay/usr/local/lib/try-omarchy/repair-host-window
new file mode 100755
index 0000000..7617a29
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/repair-host-window
@@ -0,0 +1,18 @@
+#!/bin/bash
+# Repair only the pinned idle service shipped by earlier Try Omarchy images.
+# An Omarchy upgrade or a user's edit must never be replaced with an older file.
+set -euo pipefail
+case " $(cat "${TRY_OMARCHY_CMDLINE:-/proc/cmdline}" 2>/dev/null) " in
+  *" tryomarchy.host=linux "*) ;;
+  *) exit 0 ;;
+esac
+path=/usr/share/omarchy/shell/plugins/services/idle/Service.qml
+replacement=/usr/share/try-omarchy/host-window-idle.qml
+[[ -f $path && -f $replacement && ! -L $path ]] || exit 0
+read -r digest _ < <(sha256sum "$path")
+case $digest in
+  50f5c81e2e94fab32395a5bc3cce982e30a10ab1b3f56cc58f29055951518a51|02512cc96ecb82005b82e947ed891549d1721cbefad14fdb2eca9ab50e88c9eb)
+    install -m 0644 "$replacement" "$path.try-omarchy"
+    mv -f -- "$path.try-omarchy" "$path"
+    ;;
+esac
