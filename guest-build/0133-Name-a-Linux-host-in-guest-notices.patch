index 0000000..85579a9
--- /dev/null
+++ b/guest/tests/test_host_names.py
@@ -0,0 +1,87 @@
+"""Exercise both host defaults and preservation of personal launcher entries."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+OVERLAY = Path(__file__).resolve().parents[1] / 'factory-overlay'
+HELPER = OVERLAY / 'usr/local/lib/try-omarchy/apply-host-names'
+SEEDS = OVERLAY / 'usr/share/try-omarchy/host-applications'
+
+
+class HostNamesTests(unittest.TestCase):
+    def test_defaults_switch_both_ways_and_custom_entries_survive(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            entries = root / 'applications'
+            shutil.copytree(SEEDS / 'windows', entries)
+            cmdline = root / 'cmdline'
+            env = dict(os.environ, TRY_OMARCHY_CMDLINE=str(cmdline),
+                       TRY_OMARCHY_APPLICATIONS=str(entries), TRY_OMARCHY_HOST_APPLICATIONS=str(SEEDS))
+            def apply(words):
+                cmdline.write_text(words + '\n')
+                subprocess.run([str(HELPER)], env=env, check=True)
+            for words, host in [('root=/dev/vda', 'windows'), ('tryomarchy.host=linux', 'linux'),
+                                ('tryomarchy.host=linuxish', 'windows')]:
+                apply(words)
+                for path in entries.iterdir():
+                    self.assertEqual(path.read_bytes(), (SEEDS / host / path.name).read_bytes())
+            paths = sorted(entries.iterdir())
+            paths[0].write_text('personal launcher\n')
+            paths[1].unlink()
+            target = root / 'personal.desktop'
+            target.write_text('linked launcher\n')
+            paths[2].unlink()
+            paths[2].symlink_to(target)
+            apply('tryomarchy.host=linux')
+            self.assertEqual(paths[0].read_text(), 'personal launcher\n')
+            self.assertFalse(paths[1].exists())
+            self.assertTrue(paths[2].is_symlink())
+            self.assertEqual(target.read_text(), 'linked launcher\n')
+
+    def test_power_labels_switch_on_exact_host_flag_and_preserve_custom_files(self):
+        payload = OVERLAY / 'usr/share/try-omarchy/guest-qol'
+        hooks = [hook for hook in json.loads((payload / 'manifest.json').read_text())
+                 if hook['path'] in ('usr/bin/omarchy-powerprofiles-set',
+                     'usr/share/omarchy/shell/plugins/menu/Menu.qml',
+                     'usr/share/omarchy/shell/plugins/panels/power/Panel.qml')]
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            cmdline = root / 'cmdline'
+            env = dict(os.environ, TRY_OMARCHY_CMDLINE=str(cmdline),
+                       TRY_OMARCHY_APPLICATIONS=str(root / 'absent'),
+                       TRY_OMARCHY_POWER_ROOT=str(root), TRY_OMARCHY_POWER_PAYLOAD=str(payload))
+            for old in (False, True):
+                for hook in hooks:
+                    version = hook.get('previousVersions', [hook])[0] if old else hook
+                    path = root / hook['path']
+                    path.parent.mkdir(parents=True, exist_ok=True)
+                    path.write_bytes((payload / version['asset']).read_bytes())
+                    path.chmod(hook['mode'])
+                for words, label in (('root=/dev/vda', 'Managed by Windows'),
+                                     ('tryomarchy.host=linux', 'Managed by the host computer'),
+                                     ('tryomarchy.host=linuxish', 'Managed by Windows')):
+                    cmdline.write_text(words)
+                    subprocess.run([str(HELPER)], env=env, check=True)
+                    for hook in hooks:
+                        self.assertIn(label, (root / hook['path']).read_text())
+                    menu = (root / hooks[1]['path']).read_text()
+                    provider = menu.split('"power-profiles": {', 1)[1].split('\n    }', 1)[0]
+                    script = json.loads(provider.split('script: ', 1)[1].split('\n', 1)[0].rstrip(','))
+                    result = subprocess.run(['bash', '-c', script], capture_output=True, text=True, check=True)
+                    self.assertEqual(result.stdout, label + '\tdefault\tdefault\n')
+            paths = [root / hook['path'] for hook in hooks]
+            paths[0].write_text('personal power command\n')
+            paths[1].unlink()
+            paths[2].unlink()
+            paths[2].symlink_to(paths[0])
+            cmdline.write_text('tryomarchy.host=linux')
+            subprocess.run([str(HELPER)], env=env, check=True)
+            self.assertEqual(paths[0].read_text(), 'personal power command\n')
+            self.assertFalse(paths[1].exists())
+            self.assertTrue(paths[2].is_symlink())
+        service = (OVERLAY / 'etc/systemd/system/try-omarchy-catch-up.service').read_text()
+        self.assertIn('ExecStartPost=/usr/local/lib/try-omarchy/apply-host-names', service)
