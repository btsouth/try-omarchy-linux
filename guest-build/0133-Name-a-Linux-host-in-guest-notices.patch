diff --git a/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat b/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat
index 6ce51a3..2fcbed2 100755
--- a/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat
+++ b/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat
@@ -7,11 +7,59 @@ run_latehook() {
     kernel=$(uname -r)
     modules_marker="$root/usr/lib/modules/$kernel/.tryomarchy-complete"
     [ -d "$root" ] || return 0
+    # Validate even on a retry where the overlay already advanced its marker.
+    lineage="$root/var/lib/try-omarchy/guest-series-origin"
+    if [ -e "$lineage" ] || [ -L "$lineage" ]; then
+        [ ! -L "$lineage" ] && [ -f "$lineage" ] || return 1
+        record=$(cat "$lineage" 2>/dev/null) || return 1
+        case $record in
+            linux:[0-9]|linux:[1-4][0-9]|windows:[0-9]|windows:[1-4][0-9]|ambiguous:4[0-8]) ;;
+            *) echo "ERROR: Invalid Try Omarchy guest lineage" >&2; return 1 ;;
+        esac
+    fi
     if [ "$(cat "$marker" 2>/dev/null)" = "$version" ] &&
        [ "$(cat "$modules_marker" 2>/dev/null)" = "$version" ]; then
         return 0
     fi
 
+    previous=$(cat "$marker" 2>/dev/null)
+    previous_revision=${previous%%:*}
+    case $previous_revision in
+        ''|*[!0-9]*) ;;
+        *)
+            if [ "$previous_revision" -lt 50 ] && [ ! -e "$lineage" ]; then
+                origin=windows
+                # These paths/content shipped only in the old Linux fork:
+                # 0103 Vulkan env, 0104 host lease, 0106 display scale,
+                # 0107 readiness, 0114 app labels, 0115 host notices.
+                if [ -f "$root/usr/local/lib/try-omarchy/vulkan-env" ] ||
+                   [ -f "$root/usr/local/lib/try-omarchy/host-window" ] ||
+                   [ -f "$root/etc/systemd/user/try-omarchy-desktop-ready.service" ] ||
+                   [ -f "$root/usr/local/lib/try-omarchy/desktop-ready" ] ||
+                   grep -q 'OMARCHY_DISPLAY_SYNC_HOST_SCALE' "$root/usr/local/bin/omarchy-native-display-sync" 2>/dev/null ||
+                   grep -q 'def host_is_linux' "$root/usr/local/lib/try-omarchy/approved-apps-sync" 2>/dev/null ||
+                   grep -q 'Host app launch is unavailable' "$root/usr/local/bin/try-omarchy-windows-app" 2>/dev/null ||
+                   grep -q 'def host_name' "$root/usr/local/bin/file-transfer-window" 2>/dev/null; then
+                    origin=linux
+                elif [ "$previous_revision" -ge 40 ] && [ "$previous_revision" -le 48 ] &&
+                     [ ! -f "$root/usr/share/try-omarchy/guest-qol/manifest.json" ] &&
+                     [ ! -f "$root/usr/local/lib/try-omarchy/update-battery-dkms" ]; then
+                    # Windows 0122/0124 are absent from the old Linux fork.
+                    # With neither lineage proven, prefer Linux's stricter SSH
+                    # cutoff and retry missing payloads over exposing a password.
+                    origin=ambiguous
+                fi
+                mkdir -p "$(dirname "$lineage")" || return 1
+                temporary=$(mktemp "$lineage.XXXXXX") || return 1
+                if ! printf '%s:%s\n' "$origin" "$previous_revision" >"$temporary" ||
+                   ! mv -f "$temporary" "$lineage"; then
+                    rm -f "$temporary"
+                    return 1
+                fi
+            fi
+            ;;
+    esac
+
     echo ":: Updating Try Omarchy launcher integration"
     if ! tar -xf /tryomarchy-compat-overlay.tar -C "$root"; then
         echo "ERROR: Try Omarchy launcher integration update failed" >&2
