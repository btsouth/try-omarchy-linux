diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-names b/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-names
new file mode 100755
index 0000000..91d65ee
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-names
@@ -0,0 +1,60 @@
+#!/usr/bin/python3 -I
+"""Select host desktop labels without changing custom or symlinked entries."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+cmdline = Path(os.environ.get("TRY_OMARCHY_CMDLINE", "/proc/cmdline"))
+try:
+    linux = "tryomarchy.host=linux" in cmdline.read_text().split()
+except OSError:
+    linux = False
+entries = Path(os.environ.get("TRY_OMARCHY_APPLICATIONS", "/usr/share/applications"))
+seeds = Path(os.environ.get("TRY_OMARCHY_HOST_APPLICATIONS", "/usr/share/try-omarchy/host-applications"))
+for name in ("try-omarchy-file-transfers.desktop", "try-omarchy-host-settings.desktop", "try-omarchy-follow-timezone.desktop"):
+    path = entries / name
+    if path.is_symlink() or not path.is_file():
+        continue
+    windows = (seeds / "windows" / name).read_bytes()
+    other = (seeds / "linux" / name).read_bytes()
+    current = path.read_bytes()
+    wanted = other if linux else windows
+    if current in (windows, other) and current != wanted:
+        temporary = path.with_name(path.name + ".try-omarchy")
+        # Refuse a pre-existing temporary file, including a symlink.
+        with temporary.open("xb") as output:
+            output.write(wanted)
+        temporary.chmod(0o644)
+        temporary.replace(path)
+
+# The Windows quality-of-life payload is immutable. Select host wording only
+# in its recognized installed versions, including the older power panels.
+root = Path(os.environ.get("TRY_OMARCHY_POWER_ROOT", "/"))
+payload = Path(os.environ.get("TRY_OMARCHY_POWER_PAYLOAD", "/usr/share/try-omarchy/guest-qol"))
+if (payload / "manifest.json").is_file():
+    for hook in json.loads((payload / "manifest.json").read_text()):
+        if hook["path"] not in ("usr/bin/omarchy-powerprofiles-set",
+                                "usr/share/omarchy/shell/plugins/menu/Menu.qml",
+                                "usr/share/omarchy/shell/plugins/panels/power/Panel.qml"):
+            continue
+        path = root / hook["path"]
+        if any(parent.is_symlink() for parent in (path, *path.parents)) or not path.is_file():
+            continue
+        for version in (hook, *hook.get("previousVersions", [])):
+            windows = (payload / version["asset"]).read_bytes()
+            if hashlib.sha256(windows).hexdigest() != version["afterSha256"]:
+                raise ValueError("power label payload digest mismatch")
