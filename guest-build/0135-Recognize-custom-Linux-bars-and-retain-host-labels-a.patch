@@ -1,3 +1,4 @@
+import json
 import os
 import pathlib
 import subprocess
@@ -6,12 +7,12 @@ import unittest
 
 
 SCRIPT = pathlib.Path(__file__).resolve().parents[1] / "factory-overlay/usr/local/lib/try-omarchy/desktop-ready"
-VISIBLE_LAYERS = '{"Virtual-1":{"levels":{"0":[{"namespace":"omarchy-background","w":936,"h":696,"alpha":1}],"2":[{"namespace":"omarchy-bar","w":936,"h":26,"alpha":1}]}}}'
+VISIBLE_LAYERS = '{"Virtual-1":{"levels":{"0":[{"namespace":"omarchy-background","w":936,"h":696,"alpha":1,"pid":100}],"2":[{"namespace":"omarchy-bar","w":936,"h":26,"alpha":1,"pid":100}]}}}'
 
 
 class DesktopReadyTests(unittest.TestCase):
     def run_probe(self, monitor_output: str, shell_running: bool,
-                  layers_output: str = VISIBLE_LAYERS) -> tuple[subprocess.CompletedProcess, str]:
+                  layers_output: str = VISIBLE_LAYERS, shell_response: str = "ok") -> tuple[subprocess.CompletedProcess, str]:
         with tempfile.TemporaryDirectory() as temp:
             root = pathlib.Path(temp)
             bin_dir = root / "bin"
@@ -19,15 +20,17 @@ class DesktopReadyTests(unittest.TestCase):
             (bin_dir / "hyprctl").write_text(
                 "#!/bin/sh\nif [ \"$2\" = monitors ]; then printf '%s\\n' \"$TEST_MONITORS\"; "
                 "else printf '%s\\n' \"$TEST_LAYERS\"; fi\n")
+            (bin_dir / "omarchy-shell").write_text(
+                '#!/bin/sh\n[ "$*" = "shell ping" ] || exit 1\nprintf "%s\\n" "$TEST_SHELL_RESPONSE"\n')
             (bin_dir / "pgrep").write_text("#!/bin/sh\nexit " + ("0" if shell_running else "1") + "\n")
             (bin_dir / "socat").write_text("#!/bin/sh\ncat > \"$TEST_SIGNAL_FILE\"\n")
             (bin_dir / "logger").write_text("#!/bin/sh\nexit 0\n")
-            for name in ("hyprctl", "pgrep", "socat", "logger"):
+            for name in ("hyprctl", "omarchy-shell", "pgrep", "socat", "logger"):
                 (bin_dir / name).chmod(0o755)
             signal = root / "signal"
             env = dict(os.environ, PATH=str(bin_dir) + ":" + os.environ["PATH"],
                        TEST_SIGNAL_FILE=str(signal), TEST_MONITORS=monitor_output,
-                       TEST_LAYERS=layers_output, TRY_OMARCHY_DESKTOP_READY_ATTEMPTS="5",
+                       TEST_LAYERS=layers_output, TEST_SHELL_RESPONSE=shell_response, TRY_OMARCHY_DESKTOP_READY_ATTEMPTS="5",
                        TRY_OMARCHY_DESKTOP_READY_INTERVAL="0")
             result = subprocess.run([str(SCRIPT)], env=env, capture_output=True, text=True)
             return result, signal.read_text() if signal.exists() else ""
@@ -48,8 +51,38 @@ class DesktopReadyTests(unittest.TestCase):
         self.assertEqual(signal, "")
 
     def test_missing_shell_layers_keep_setup_waiting(self):
-        for layers in ('{}', '{"Virtual-1":{"levels":{"0":[{"namespace":"omarchy-background","w":936,"h":696,"alpha":1}]}}}'):
+        for layers in ('{}', '{"Virtual-1":{"levels":{"0":[{"namespace":"omarchy-background","w":936,"h":696,"alpha":1,"pid":100}]}}}'):
             with self.subTest(layers=layers):
                 result, signal = self.run_probe('[{"id":0}]', True, layers)
                 self.assertNotEqual(result.returncode, 0)
                 self.assertEqual(signal, "")
+
+    def test_custom_bar_namespace_signals_ready(self):
+        layers = VISIBLE_LAYERS.replace('omarchy-bar', 'my-custom-bar')
+        result, signal = self.run_probe('[{"id":0}]', True, layers)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(signal, "desktop-ready\n")
+
+    def test_unresponsive_omarchy_shell_keeps_setup_waiting(self):
+        for response in ('', 'Not ready to accept queries yet', 'Target not found.'):
+            with self.subTest(response=response):
+                result, signal = self.run_probe('[{"id":0}]', True, shell_response=response)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertEqual(signal, "")
+
+    def test_unrelated_layer_cannot_stand_in_for_the_shell_bar(self):
+        layers = json.loads(VISIBLE_LAYERS)
+        layers['Virtual-1']['levels']['2'][0]['pid'] = 200
+        result, signal = self.run_probe('[{"id":0}]', True, json.dumps(layers))
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(signal, "")
+
+    def test_hidden_or_zero_size_shell_layers_keep_setup_waiting(self):
+        for level in ('0', '2'):
+            for field in ('alpha', 'w', 'h', 'pid'):
+                with self.subTest(level=level, field=field):
+                    layers = json.loads(VISIBLE_LAYERS)
+                    layers['Virtual-1']['levels'][level][0][field] = 0
+                    result, signal = self.run_probe('[{"id":0}]', True, json.dumps(layers))
+                    self.assertNotEqual(result.returncode, 0)
+                    self.assertEqual(signal, "")
