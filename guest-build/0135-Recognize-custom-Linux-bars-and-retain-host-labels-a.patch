diff --git a/guest/factory-overlay/etc/pacman.d/hooks/95-try-omarchy-host-names.hook b/guest/factory-overlay/etc/pacman.d/hooks/95-try-omarchy-host-names.hook
new file mode 100644
index 0000000..2e16aec
--- /dev/null
+++ b/guest/factory-overlay/etc/pacman.d/hooks/95-try-omarchy-host-names.hook
@@ -0,0 +1,10 @@
+[Trigger]
+Operation = Install
+Operation = Upgrade
+Type = Package
+Target = try-omarchy-runtime
+
+[Action]
+Description = Restore Linux host labels after updating Omarchy
+When = PostTransaction
+Exec = /usr/local/lib/try-omarchy/apply-host-names --linux-only
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-names b/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-names
index c2ab277..11abb79 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-names
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-names
@@ -1,15 +1,22 @@
 #!/usr/bin/python3 -I
 """Select host desktop labels without changing custom or symlinked entries."""
+import argparse
 import hashlib
 import json
 import os
 from pathlib import Path
 
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--linux-only", action="store_true", help="Skip non-Linux hosts after package transactions")
+args = parser.parse_args()
+
 cmdline = Path(os.environ.get("TRY_OMARCHY_CMDLINE", "/proc/cmdline"))
 try:
     linux = "tryomarchy.host=linux" in cmdline.read_text().split()
 except OSError:
     linux = False
+if args.linux_only and not linux:
+    raise SystemExit(0)
 entries = Path(os.environ.get("TRY_OMARCHY_APPLICATIONS", "/usr/share/applications"))
 seeds = Path(os.environ.get("TRY_OMARCHY_HOST_APPLICATIONS", "/usr/share/try-omarchy/host-applications"))
 for name in ("try-omarchy-file-transfers.desktop", "try-omarchy-host-settings.desktop", "try-omarchy-follow-timezone.desktop"):
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/desktop-ready b/guest/factory-overlay/usr/local/lib/try-omarchy/desktop-ready
index d99c8da..037ec7e 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/desktop-ready
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/desktop-ready
@@ -1,6 +1,8 @@
 #!/bin/bash
 # Report only after the graphical session, a monitor, and the Omarchy shell's
-# background and bar surfaces have remained visible. A quickshell process can
+# background and companion shell surfaces have remained visible. Bar plugins
+# choose their own namespaces; pair them with the background by process ID,
+# and require a response from Omarchy itself. A quickshell process can
 # exist while the screen is still black. The earlier system-level "ready" is needed
 # for image rollback but does not mean the desktop can be used yet.
 set -euo pipefail
@@ -11,9 +13,11 @@ stable=0
 for ((attempt=1; attempt<=attempts; attempt++)); do
   monitors=$(hyprctl -j monitors 2>/dev/null || true)
   layers=$(hyprctl -j layers 2>/dev/null || true)
-  if [[ $monitors == \[* && $monitors != '[]' ]] && pgrep -u "$(id -u)" -x quickshell >/dev/null &&
-     jq -e '[.[] | .levels[][]? | select(.w > 0 and .h > 0 and .alpha > 0) | .namespace] |
-       (index("omarchy-background") != null and index("omarchy-bar") != null)' <<<"$layers" >/dev/null 2>&1; then
+  shell_response=$(OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy} omarchy-shell shell ping 2>/dev/null || true)
+  if [[ $shell_response == ok && $monitors == \[* && $monitors != '[]' ]] && pgrep -u "$(id -u)" -x quickshell >/dev/null &&
+     jq -e '[.[] | .levels[][]? | select(.w > 0 and .h > 0 and .alpha > 0)] |
+       . as $visible | any(.[]; .namespace == "omarchy-background" and .pid > 0 and
+         (.pid as $shell_pid | any($visible[]; .namespace != "omarchy-background" and .pid == $shell_pid)))' <<<"$layers" >/dev/null 2>&1; then
     ((stable+=1))
     if ((stable >= 5)); then
       for retry in {1..10}; do
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 8d45a25..eb18e7a 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -79,6 +79,7 @@ install -m 0644 /usr/share/omarchy/shell/plugins/services/idle/Service.qml /usr/
 install -m 0644 /usr/share/omarchy/shell/plugins/panels/clock/BarWidget.qml /usr/share/try-omarchy/clock-timezone-refresh.qml
 
 compat_paths=(
+  etc/pacman.d/hooks/95-try-omarchy-host-names.hook
   usr/local/lib/try-omarchy/apply-host-names
   usr/share/try-omarchy/host-applications
   usr/local/lib/try-omarchy/repair-clock-timezone
@@ -248,7 +249,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 53 reports Linux desktop readiness after the Omarchy shell starts.
 # Revision 54 names approved apps for Linux and reports agent version 5 there.
 # Revision 55 names Linux hosts in notices and repairs their shipped clock widget.
-compat_revision=55
+# Revision 56 recognizes custom Linux bars and retains Linux labels after updates.
+compat_revision=56
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
