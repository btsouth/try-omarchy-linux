 guest/tests/test_battery_details.py           |  2 +-
 guest/tests/test_desktop_ready.py             | 43 ++++++++++++--
 guest/tests/test_guest_qol.py                 |  2 +-
 guest/tests/test_host_names.py                | 56 +++++++++++++++++++
