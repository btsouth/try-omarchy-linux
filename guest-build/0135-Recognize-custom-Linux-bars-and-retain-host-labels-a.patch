diff --git a/guest/tests/test_host_names.py b/guest/tests/test_host_names.py
index 322271a..321bdee 100644
--- a/guest/tests/test_host_names.py
+++ b/guest/tests/test_host_names.py
@@ -2,6 +2,7 @@
 import json
 import os
 from pathlib import Path
+import shlex
 import shutil
 import subprocess
 import tempfile
@@ -94,3 +95,58 @@ class HostNamesTests(unittest.TestCase):
             self.assertTrue(paths[2].is_symlink())
         service = (OVERLAY / 'etc/systemd/system/try-omarchy-catch-up.service').read_text()
         self.assertIn('ExecStartPost=/usr/local/lib/try-omarchy/apply-host-names', service)
+
+    def test_runtime_transaction_hook_reapplies_linux_power_labels(self):
+        hook = (OVERLAY / 'etc/pacman.d/hooks/95-try-omarchy-host-names.hook').read_text()
+        trigger, action = hook.split('[Action]')
+        self.assertIn('Operation = Install', trigger)
+        self.assertIn('Operation = Upgrade', trigger)
+        self.assertIn('Type = Package', trigger)
+        self.assertIn('Target = try-omarchy-runtime', trigger)
+        self.assertIn('When = PostTransaction', action)
+        command = shlex.split(next(line.removeprefix('Exec = ') for line in action.splitlines()
+                                   if line.startswith('Exec = ')))
+        self.assertEqual(command, ['/usr/local/lib/try-omarchy/apply-host-names', '--linux-only'])
+        payload = OVERLAY / 'usr/share/try-omarchy/guest-qol'
+        power = [item for item in json.loads((payload / 'manifest.json').read_text())
+                 if item['path'] in ('usr/bin/omarchy-powerprofiles-set',
+                     'usr/share/omarchy/shell/plugins/menu/Menu.qml',
+                     'usr/share/omarchy/shell/plugins/panels/power/Panel.qml')]
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            cmdline = root / 'cmdline'
+            entries = root / 'applications'
+            env = dict(os.environ, TRY_OMARCHY_CMDLINE=str(cmdline),
+                       TRY_OMARCHY_APPLICATIONS=str(entries), TRY_OMARCHY_HOST_APPLICATIONS=str(SEEDS),
+                       TRY_OMARCHY_POWER_ROOT=str(root), TRY_OMARCHY_POWER_PAYLOAD=str(payload))
+            command[0] = str(HELPER)
+            for words, linux in (('root=/dev/vda tryomarchy.host=linux quiet', True),
+                                 ('root=/dev/vda', False), ('tryomarchy.host=linuxish', False)):
+                for transaction in ('Install', 'Upgrade'):
+                    with self.subTest(words=words, transaction=transaction):
+                        # Model the runtime extraction restoring the immutable Windows payload.
+                        for item in power:
+                            path = root / item['path']
+                            path.parent.mkdir(parents=True, exist_ok=True)
+                            path.write_bytes((payload / item['asset']).read_bytes())
+                            path.chmod(item['mode'])
+                        shutil.copytree(SEEDS / 'windows', entries, dirs_exist_ok=True)
+                        cmdline.write_text(words)
+                        subprocess.run(command, env=env, check=True)
+                        for item in power:
+                            wanted = (payload / item['asset']).read_bytes()
+                            if linux:
+                                wanted = wanted.replace(b'Managed by Windows', b'Managed by the host computer')
+                                wanted = wanted.replace(b'Power profiles are managed by Windows',
+                                                        b'Power profiles are managed by the host computer')
+                            self.assertEqual((root / item['path']).read_bytes(), wanted)
+                        for path in entries.iterdir():
+                            self.assertEqual(path.read_bytes(), (SEEDS / ('linux' if linux else 'windows') / path.name).read_bytes())
+            # Non-Linux transactions must skip even recognized Linux files and missing payloads.
+            cmdline.write_text('tryomarchy.host=windows')
+            path = root / power[0]['path']
+            path.write_text('Managed by the host computer\n')
+            env['TRY_OMARCHY_POWER_PAYLOAD'] = str(root / 'absent-payload')
+            env['TRY_OMARCHY_HOST_APPLICATIONS'] = str(root / 'absent-seeds')
+            subprocess.run(command, env=env, check=True)
+            self.assertEqual(path.read_text(), 'Managed by the host computer\n')
