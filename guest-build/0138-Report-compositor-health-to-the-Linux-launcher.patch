@@ -258,7 +259,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 56 recognizes custom Linux bars and retains Linux labels after updates.
 # Revision 57 delivers the VM night-light shader and guarded defaults.
