+-- A connector's own rule already ran above this fragment. Keep its scale on
+-- reload, including computed Lua expressions; display sync then rounds known
+-- numeric overrides against the fresh EDID mode just like the single path.
+local function omarchy_connector_scale(output)
+  local config_dir = os.getenv("XDG_CONFIG_HOME") or ((os.getenv("HOME") or "") .. "/.config")
+  local file = io.open(config_dir .. "/hypr/monitors.lua", "r")
+  if not file then
+    return nil
+  end
+  local text = file:read("*a")
+  file:close()
+  text = text:gsub("%-%- BEGIN OMARCHY QEMU PROFILE.-%-%- END OMARCHY QEMU PROFILE", "")
+  text = text:gsub("%-%-%[%[.-%]%]", ""):gsub("%-%-[^\n]*", "")
+  for rule in text:gmatch("hl%.monitor%s*(%b())") do
+    local name = rule:match('output%s*=%s*"([^"\n]*)"') or rule:match("output%s*=%s*'([^'\n]*)'")
+    local scale = rule:match("scale%s*=%s*([^,}]+)")
+    if name == output and scale then
+      return scale:match("^%s*[\"']auto[\"']%s*$") and "auto" or "keep"
+    end
+  end
+  return nil
+end
