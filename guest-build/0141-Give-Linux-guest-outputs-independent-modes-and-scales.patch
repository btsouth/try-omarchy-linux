+# A literal connector scale takes precedence over the catch-all variable.
+# Unknown Lua expressions are left to Hyprland: update only the mode in that
+# case, rather than replacing a user's computed scale with an EDID guess.
+configured_output_scale() {
+  local config=${OMARCHY_DISPLAY_SYNC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua}
+  python3 - "$config" "$1" "$2" <<'PYTHON'
+from pathlib import Path
+import re
+import sys
+try:
+    text = Path(sys.argv[1]).read_text()
+except OSError:
+    print(sys.argv[3])
+    raise SystemExit
+# Do not scan our replay code as if it were a user rule.
+text = re.sub(r"-- BEGIN OMARCHY QEMU PROFILE.*?-- END OMARCHY QEMU PROFILE", "", text, flags=re.S)
+text = re.sub(r"--\[(=*)\[.*?\]\1\]", "", text, flags=re.S)
+text = re.sub(r"--[^\n]*", "", text)
+values = dict(re.findall(r'(?:local\s+)?(\w+)\s*=\s*([0-9]+(?:\.[0-9]+)?)\s*(?=--|[,;\n]|$)', text))
+result = sys.argv[3]
+for rule in re.findall(r'hl\.monitor\s*\(\s*\{(.*?)\}\s*\)', text, re.S):
+    output = re.search(r"\boutput\s*=\s*([\"'])(.*?)\1", rule)
+    scale = re.search(r'\bscale\s*=\s*([^,}]+)', rule)
+    if not output or output[2] != sys.argv[2] or not scale:
+        continue
+    value = scale[1].strip().strip('"\'')
+    value = values.get(value, value)
+    result = (value if re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', value) and float(value) > 0
+              else '' if value == 'auto' else 'keep')
+print(result)
+PYTHON
+}
