+local function omarchy_synced_display_outputs()
+  if not omarchy_kernel_option_enabled("tryomarchy.host=linux") then
+    return {}
+  end
+  local runtime_dir = os.getenv("XDG_RUNTIME_DIR")
+  if not runtime_dir or runtime_dir == "" then
+    return {}
+  end
+  local file = io.open(runtime_dir .. "/try-omarchy/display-mode.outputs", "r")
+  if not file then
+    return {}
+  end
+  local outputs = {}
+  for line in file:lines() do
+    local output, mode, scale, connector = line:match("^([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)$")
+    if output and output:match("^Virtual%-%d+$") and connector:match("^card%d+%-Virtual%-%d+$") and connector:match("%-(Virtual%-%d+)$") == output
+        and mode:match("^modeline [%d ]+ [+-]hsync [+-]vsync$")
+        and (scale == "auto" or scale == "keep" or scale:match("^%d+%.?%d*$")) then
+      local status = io.open((os.getenv("OMARCHY_DISPLAY_SYNC_DRM_ROOT") or "/sys/class/drm") .. "/" .. connector .. "/status", "r")
+      if status then
+        local connected = status:read("*l") == "connected"
+        status:close()
+        if connected then
+          outputs[#outputs + 1] = { output = output, mode = mode, scale = scale }
+        end
+      end
+    end
+  end
+  file:close()
+  return #outputs > 1 and outputs or {}
+end
