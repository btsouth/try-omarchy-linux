+"""Linux connector rules use the shared EDID decoder and preserve user intent."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import shutil
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+SYNC = GUEST / 'native-overlay/usr/local/bin/omarchy-native-display-sync'
+HIGH = 'modeline 594 3840 3928 3972 4120 2160 2164 2169 2205 -hsync -vsync'
+LOW = 'modeline 149 1920 2008 2052 2200 1080 1084 1089 1125 -hsync -vsync'
+
+
+def edid(width, height, width_cm, height_cm):
+    data = bytearray(256)
+    data[:8] = b'\x00\xff\xff\xff\xff\xff\xff\x00'
+    data[21:23] = bytes([width_cm, height_cm])
+    data[126] = 1
+    block = bytearray(128)
+    block[:8] = bytes([0x70, 0x13, 0x17, 0x03, 0, 0x03, 0, 0x14])
+    block[8:11] = ((594_000_000 if width == 3840 else 148_500_000) // 10_000 - 1).to_bytes(3, 'little')
+    block[11] = 0x80
+    for offset, value in [(12, width), (14, 280), (16, 88), (18, 44),
+                          (20, height), (22, 45), (24, 4), (26, 5)]:
+        block[offset:offset+2] = (value - 1).to_bytes(2, 'little')
+    block[28] = -sum(block[1:28]) & 255
+    block[127] = -sum(block[:127]) & 255
+    data[128:] = block
+    data[127] = -sum(data[:127]) & 255
+    return data
+
+
+class OutputScaleTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.drm = self.root / 'drm'
+        self.bin = self.root / 'bin'
+        self.bin.mkdir()
+        self.log = self.root / 'log'
+        self.rules = self.root / 'rules.json'
+        fake = self.bin / 'hyprctl'
+        fake.write_text('''#!/usr/bin/env python3
+import json, os, re, sys
+from pathlib import Path
+log = Path(os.environ['HYPRCTL_LOG'])
+with log.open('a') as f: f.write(' '.join(sys.argv[1:]) + '\\n')
+p = Path(os.environ['HYPRCTL_RULES'])
+rules = json.loads(p.read_text()) if p.exists() else {}
+if sys.argv[1] == 'reload':
+    rules = {}
+else:
+    rule = dict(re.findall(r'(output|mode|scale) = "([^"]*)"', sys.argv[2]))
+    rules.setdefault(rule['output'], {}).update(rule)
+p.write_text(json.dumps(rules))
+print('ok')
+''')
+        fake.chmod(0o755)
+        self.config = self.root / 'monitors.lua'
+        self.cmdline = self.root / 'cmdline'
+        self.cmdline.write_text('tryomarchy.host=linux tryomarchy.host-scale=1\n')
+        self.state = self.root / 'runtime/display-mode'
+        self.env = dict(os.environ, PATH=f'{self.bin}:{os.environ["PATH"]}',
+                        HYPRCTL_LOG=str(self.log), HYPRCTL_RULES=str(self.rules),
+                        TRY_OMARCHY_CMDLINE=str(self.cmdline),
+                        OMARCHY_DISPLAY_SYNC_DRM_ROOT=str(self.drm),
+                        OMARCHY_DISPLAY_SYNC_STATE=str(self.state),
+                        OMARCHY_DISPLAY_SYNC_CONFIG=str(self.config))
+        self.connector(1, edid(3840, 2160, 51, 29))
+
+    def connector(self, number, data):
+        connector = self.drm / f'card0-Virtual-{number}'
+        connector.mkdir(parents=True, exist_ok=True)
+        (connector / 'status').write_text('connected\n')
+        (connector / 'edid').write_bytes(data)
+        return connector
+
+    def run_sync(self, reload=False):
+        result = subprocess.run([str(SYNC), '--config-reloads-from-stdin' if reload else '--from-stdin'],
+                                input='configreloaded>>\n' if reload else 'ACTION=change\nHOTPLUG=1\n',
+                                text=True, env=self.env, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return json.loads(self.rules.read_text())
+
+    def test_single_output_retains_exact_rule_and_record(self):
+        self.run_sync()
+        self.assertEqual(self.log.read_text(), f'eval hl.monitor({{ output = "", mode = "{HIGH}", scale = "2" }})\n')
+        self.assertEqual(self.state.read_text(), HIGH + '\n2\n')
+        self.assertFalse(Path(str(self.state) + '.outputs').exists())
+        self.config.write_text('local omarchy_monitor_scale = 1.3 -- explicit\n')
+        self.assertEqual(self.run_sync()['']['scale'], '1.333333')
+
+    def test_two_outputs_have_independent_modes_and_scales_and_reload(self):
+        self.connector(2, edid(1920, 1080, 51, 29))
+        rules = self.run_sync()
+        self.assertEqual(set(rules), {'Virtual-1', 'Virtual-2'})
+        self.assertEqual(rules['Virtual-1'], dict(output='Virtual-1', mode=HIGH, scale='2'))
+        self.assertEqual(rules['Virtual-2'], dict(output='Virtual-2', mode=LOW, scale='1'))
+        self.assertFalse(self.state.exists())
+        saved = Path(str(self.state) + '.outputs').read_text()
+        self.assertEqual(saved, f'Virtual-1\t{HIGH}\t2\tcard0-Virtual-1\nVirtual-2\t{LOW}\t1\tcard0-Virtual-2\n')
+        self.assertEqual(self.run_sync(reload=True), rules)
+
+    def test_connector_override_wins_over_global_scale_and_other_edid(self):
+        self.connector(2, edid(1920, 1080, 51, 29))
+        self.config.write_text('''local omarchy_monitor_scale = 2
+-- hl.monitor({ output = "Virtual-1", scale = 4 })
+hl.monitor({
+  output = "Virtual-1", position = "auto", scale = 1.3
+})
+hl.monitor({ output = 'Virtual-2', scale = 'auto' })
+''')
+        rules = self.run_sync()
+        self.assertEqual(rules['Virtual-1']['scale'], '1.333333')
+        self.assertEqual(rules['Virtual-2']['scale'], '1')
+        self.config.write_text('local laptop_scale = 1.5\nhl.monitor({ output = "Virtual-1", scale = laptop_scale })\n')
+        self.assertEqual(self.run_sync()['Virtual-1']['scale'], '1.5')
+
+    def test_computed_override_keeps_hyprland_scale(self):
+        self.connector(2, edid(1920, 1080, 51, 29))
+        self.rules.write_text(json.dumps({'Virtual-1': {'output': 'Virtual-1', 'scale': '1.5'}}))
+        self.config.write_text('hl.monitor({ output = "Virtual-1", scale = choose_scale() })\n')
+        self.assertEqual(self.run_sync()['Virtual-1']['scale'], '1.5')
+        self.assertIn(f'eval hl.monitor({{ output = "Virtual-1", mode = "{HIGH}" }})', self.log.read_text())
+
+    def test_removal_clears_rules_and_returns_to_single_output_behavior(self):
+        second = self.connector(2, edid(1920, 1080, 51, 29))
+        self.run_sync()
+        (second / 'status').write_text('disconnected\n')
+        rules = self.run_sync()
+        self.assertEqual(rules, {'': dict(output='', mode=HIGH, scale='2')})
+        self.assertFalse(Path(str(self.state) + '.outputs').exists())
+        self.assertEqual(self.state.read_text(), HIGH + '\n2\n')
+        self.assertEqual(self.log.read_text().splitlines().count('reload'), 1)
+        self.run_sync()
+        self.assertEqual(self.log.read_text().splitlines().count('reload'), 1)
+        (self.drm / 'card0-Virtual-1/status').write_text('disconnected\n')
+        self.run_sync()
+        self.assertFalse(self.state.exists())
+        self.connector(2, edid(1920, 1080, 51, 29))
+        self.assertEqual(self.run_sync()['']['mode'], LOW)
+
+    def test_removal_with_two_remaining_clears_stale_connector_rule(self):
+        second = self.connector(2, edid(1920, 1080, 51, 29))
+        self.connector(3, edid(1920, 1080, 51, 29))
+        self.run_sync()
+        (second / 'status').write_text('disconnected\n')
+        self.assertEqual(set(self.run_sync()), {'Virtual-1', 'Virtual-3'})
+        self.assertNotIn('Virtual-2', Path(str(self.state) + '.outputs').read_text())
+
+    def test_unreadable_edid_does_not_forget_rule_ownership(self):
+        second = self.connector(2, edid(1920, 1080, 51, 29))
+        self.connector(3, edid(1920, 1080, 51, 29))
+        self.run_sync()
+        (second / 'edid').write_bytes(b'not an EDID')
+        self.run_sync()
+        self.assertIn('Virtual-2', Path(str(self.state) + '.outputs').read_text())
+        (second / 'status').write_text('disconnected\n')
+        self.assertEqual(set(self.run_sync()), {'Virtual-1', 'Virtual-3'})
+
+    def test_windows_multi_output_path_stays_catch_all(self):
+        self.cmdline.write_text('tryomarchy.host=windows\n')
+        self.connector(2, edid(1920, 1080, 51, 29))
+        self.run_sync()
+        self.assertEqual(set(json.loads(self.rules.read_text())), {''})
+        self.assertFalse(self.state.exists())
+        self.assertFalse(Path(str(self.state) + '.outputs').exists())
+
+    @unittest.skipUnless(shutil.which('lua'), 'Lua interpreter not installed')
+    def test_lua_replay_preserves_overrides_and_checks_hotplug(self):
+        second = self.connector(2, edid(1920, 1080, 51, 29))
+        self.config.write_text('local omarchy_monitor_scale = 2\nhl.monitor({ output = "Virtual-1", scale = 1.5 })\nhl.monitor({ output = "Virtual-2", scale = "auto" })\n')
+        self.run_sync()
+        harness = self.root / 'replay.lua'
+        harness.write_text("""
+local real_open = io.open
+io.open = function(path, mode)
+  if path == "/proc/cmdline" then return real_open(os.getenv("TRY_OMARCHY_CMDLINE"), mode) end
+  if path:match("/hypr/monitors.lua$") then return real_open(os.getenv("OMARCHY_DISPLAY_SYNC_CONFIG"), mode) end
+  return real_open(path, mode)
+end
+local real_getenv = os.getenv
+os.getenv = function(key)
+  if key == "XDG_RUNTIME_DIR" then return real_getenv("REPLAY_RUNTIME") end
+  return real_getenv(key)
+end
+omarchy_monitor_scale = 2
+hl = { config = function() end, monitor = function(rule)
+  print(rule.output .. "\\t" .. rule.mode .. "\\t" .. (rule.scale or "keep"))
+end }
+o = { exec_on_start = function() end }
+dofile(arg[1])
+""")
+        env = dict(self.env, REPLAY_RUNTIME=str(self.state.parent))
+        # Replay uses the public runtime path's fixed basename.
+        replay_state = self.state.parent / 'try-omarchy/display-mode.outputs'
+        replay_state.parent.mkdir()
+        replay_state.write_bytes(Path(str(self.state) + '.outputs').read_bytes())
+        def replay():
+            result = subprocess.run(['lua', str(harness), str(GUEST / 'fragments/hypr-monitors-qemu.append.lua')],
+                                    text=True, capture_output=True, env=env)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            return result.stdout.splitlines()
+        self.cmdline.write_text('omarchy.qemu=1 tryomarchy.host=linux\n')
+        self.assertEqual(replay(), [f'Virtual-1\t{HIGH}\tkeep', f'Virtual-2\t{LOW}\t1'])
+        (second / 'status').write_text('disconnected\n')
+        self.assertEqual(replay(), [])
+        (second / 'status').write_text('connected\n')
+        self.cmdline.write_text('omarchy.qemu=1 tryomarchy.host=windows\n')
+        self.assertEqual(replay(), [])
+
+    def test_payload_and_revision_delivery(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        self.assertIn('compat_revision=62', finalizer)
+        self.assertIn('usr/local/bin/omarchy-native-display-sync', finalizer)
+        self.assertIn('usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua', finalizer)
+        self.assertEqual((GUEST / 'fragments/hypr-monitors-qemu.append.lua').read_bytes(),
+                         (GUEST / 'factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua').read_bytes())
