diff --git a/guest/tests/test_compositor_health.py b/guest/tests/test_compositor_health.py
index 9e53726..a18115c 100644
--- a/guest/tests/test_compositor_health.py
+++ b/guest/tests/test_compositor_health.py
@@ -27,14 +27,35 @@ class CompositorHealthTests(unittest.TestCase):
                 self.assertEqual(args[-3:], ['hyprctl', '-j', 'monitors'])
                 return subprocess.CompletedProcess(args, 0, '[{"name":"Virtual-1"}]')
             self.assertEqual(health.probe(root, run), 'ok')
+            idle = lambda: False
             for output in ['[]', 'null', 'error', '{}']:
-                self.assertEqual(health.probe(root, lambda *a, **kw: subprocess.CompletedProcess(a,0,output)), 'unresponsive')
+                self.assertEqual(health.probe(root, lambda *a, **kw: subprocess.CompletedProcess(a,0,output), idle), 'unresponsive')
             def timeout(*a, **kw): raise subprocess.TimeoutExpired(a, 2)
-            self.assertEqual(health.probe(root, timeout), 'unresponsive')
+            self.assertEqual(health.probe(root, timeout, idle), 'unresponsive')
+            # A package update starving the compositor is busy, not frozen.
+            self.assertEqual(health.probe(root, timeout, lambda: True), 'busy')
+            # A responsive compositor is ok whatever pacman is doing.
+            self.assertEqual(health.probe(root, run, lambda: True), 'ok')
+
+    def test_package_transaction_needs_lock_and_running_pacman(self):
+        with tempfile.TemporaryDirectory() as root:
+            lock = Path(root) / 'db.lck'
+            proc = Path(root) / 'proc'
+            (proc / '41').mkdir(parents=True)
+            (proc / '41' / 'comm').write_text('bash\n')
+            self.assertFalse(health.package_transaction(str(lock), str(proc)))
+            lock.touch()
+            # A lock left behind by a crashed pacman must not hide a freeze.
+            self.assertFalse(health.package_transaction(str(lock), str(proc)))
+            (proc / '42').mkdir()
+            (proc / '42' / 'comm').write_text('pacman\n')
+            self.assertTrue(health.package_transaction(str(lock), str(proc)))
+            lock.unlink()
+            self.assertFalse(health.package_transaction(str(lock), str(proc)))
 
     def test_existing_disks_receive_health_files(self):
         finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
-        self.assertIn('compat_revision=65', finalizer)
+        self.assertIn('compat_revision=66', finalizer)
         for name in ['agent', 'compositor-health']:
             self.assertIn('  usr/local/lib/try-omarchy/' + name, finalizer)
         self.assertTrue(HELPER.stat().st_mode & 0o111)
