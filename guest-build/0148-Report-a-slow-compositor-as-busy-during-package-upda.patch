diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/compositor-health b/guest/factory-overlay/usr/local/lib/try-omarchy/compositor-health
index e38adfc..d724985 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/compositor-health
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/compositor-health
@@ -7,8 +7,23 @@ import pathlib
 import pwd
 import subprocess
 
+PACMAN_LOCK = "/var/lib/pacman/db.lck"
 
-def probe(runtime_root="/run/user", run=subprocess.run):
+
+def package_transaction(lock=PACMAN_LOCK, proc="/proc"):
+    """A held pacman lock with pacman still running, never a stale lock."""
+    if not os.path.exists(lock):
+        return False
+    for comm in glob.glob(f"{proc}/[0-9]*/comm"):
+        try:
+            if pathlib.Path(comm).read_text().strip() == "pacman":
+                return True
+        except OSError:
+            pass
+    return False
+
+
+def probe(runtime_root="/run/user", run=subprocess.run, busy=package_transaction):
     for socket in sorted(glob.glob(f"{runtime_root}/*/hypr/*/.socket.sock")):
         path = pathlib.Path(socket)
         try:
@@ -26,7 +41,9 @@ def probe(runtime_root="/run/user", run=subprocess.run):
                 return "ok"
         except (OSError, ValueError, KeyError, subprocess.SubprocessError):
             pass
-        return "unresponsive"
+        # A package update can starve a CPU-rendered compositor for minutes.
+        # Restarting then would cut pacman off mid-transaction.
+        return "busy" if busy() else "unresponsive"
     # Login/logout is not a freeze. The next compositor heartbeat arms again.
     return "inactive"
 
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 7650aba..5f97c9b 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -272,7 +272,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 63 makes Omarchy's Snapper setup inert on the ext4 guest.
 # Revision 64 receives large clipboard frames without suffix-pattern stalls.
 # Revision 65 repairs the shell palette for Qt 6.12.
-compat_revision=65
+# Revision 66 reports a slow compositor as busy while pacman runs.
+compat_revision=66
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
