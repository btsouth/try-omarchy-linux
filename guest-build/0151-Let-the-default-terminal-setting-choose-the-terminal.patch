diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
index 7f95aca..283ed61 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
@@ -12,6 +12,8 @@
 #     once per user, keeping the original file beside it
 #   - make SSH accept only keys for the quick-start account, whose password
 #     is public, once per disk
+#   - remove the Foot-only xdg-terminal-exec an older image put in
+#     /usr/local/bin, when it is still our unchanged copy
 # Runs once per integration revision, before the display manager.
 set -euo pipefail
 
@@ -25,6 +27,7 @@ pinch_fragment=${TRY_OMARCHY_PINCH_FRAGMENT:-/usr/share/try-omarchy/skel-fragmen
 homes=${TRY_OMARCHY_HOMES:-/home}
 quick_start_sshd=${TRY_OMARCHY_QUICK_START_SSHD:-/usr/share/try-omarchy/quick-start-sshd.conf}
 sshd_config_dir=${TRY_OMARCHY_SSHD_CONFIG_DIR:-/etc/ssh/sshd_config.d}
+terminal_shim=${TRY_OMARCHY_TERMINAL_SHIM:-/usr/local/bin/xdg-terminal-exec}
 
 revision=$(cut -d: -f1 "$revision_file" 2>/dev/null || echo 0)
 marker="$state_dir/catch-up-revision"
@@ -233,6 +236,17 @@ secure_quick_start_ssh() {
   echo "made SSH accept only keys for the quick-start account"
 }
 
+remove_terminal_shim() {
+  # Images before revision 67 shipped a Foot-only xdg-terminal-exec that
+  # shadowed the packaged one, so Omarchy's default terminal setting never
+  # applied. Remove only our unchanged copy; an edited one is the user's.
+  local shipped=9c78611e9212023fa6ed3252ccf8fdfbbfe7b6c10ee6c255a237088ad13b8126
+  [[ -f $terminal_shim && ! -L $terminal_shim ]] || return 0
+  [[ $(sha256sum "$terminal_shim" | cut -d' ' -f1) == "$shipped" ]] || return 0
+  rm -f -- "$terminal_shim"
+  echo "removed the Foot-only xdg-terminal-exec so the default terminal setting applies"
+}
+
 legacy_pinch_comment="-- Try Omarchy's host pinch device carries gestures only."
 legacy_pinch_load='dofile("/usr/share/try-omarchy/pinch-input.lua")'
 
@@ -245,5 +259,6 @@ for home in "$homes"/*; do
   load_pinch_rules "$home" || true
 done
 secure_quick_start_ssh || true
+remove_terminal_shim || true
 printf '%s\n' "$revision" >"$marker"
 exit 0
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 5f97c9b..eb9894d 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -273,7 +273,9 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 64 receives large clipboard frames without suffix-pattern stalls.
 # Revision 65 repairs the shell palette for Qt 6.12.
 # Revision 66 reports a slow compositor as busy while pacman runs.
-compat_revision=66
+# Revision 67 removes the Foot-only xdg-terminal-exec so the default terminal
+# setting applies.
+compat_revision=67
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
