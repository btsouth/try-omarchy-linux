+    def test_revision_67_removes_only_the_unchanged_foot_terminal_shim(self) -> None:
+        self.terminal_shim.parent.mkdir(parents=True)
+        self.terminal_shim.write_bytes(RETIRED_TERMINAL_SHIM.read_bytes())
+        self.terminal_shim.chmod(0o755)
+        self.state.mkdir()
+        (self.state / "catch-up-revision").write_text("66\n")
+        self.version.write_text("67:7.2.3-arch1\n")
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertFalse(self.terminal_shim.exists())
+        self.assertEqual((self.state / "catch-up-revision").read_text(), "67\n")
+        # A shim the user edited is theirs to keep.
+        edited = RETIRED_TERMINAL_SHIM.read_text().replace("/usr/bin/foot", "/usr/bin/alacritty")
+        self.terminal_shim.write_text(edited)
+        (self.state / "catch-up-revision").write_text("66\n")
+        self.assertEqual(self.run_catch_up().returncode, 0)
+        self.assertEqual(self.terminal_shim.read_text(), edited)
+
+    def test_image_no_longer_ships_the_foot_terminal_shim(self) -> None:
+        # The packaged xdg-terminal-exec follows Omarchy's default terminal
+        # setting; a copy in /usr/local/bin would shadow it.
+        self.assertFalse((OVERLAY / "usr/local/bin/xdg-terminal-exec").exists())
+
     def test_quick_start_disk_gets_key_only_ssh_once(self) -> None:
         dropin = self.root / "sshd_config.d/90-try-omarchy-quick-start.conf"
         self.state.mkdir(parents=True)
