diff --git a/guest/tests/test_legacy_repair_payloads.py b/guest/tests/test_legacy_repair_payloads.py
new file mode 100644
index 0000000..7b7debe
--- /dev/null
+++ b/guest/tests/test_legacy_repair_payloads.py
@@ -0,0 +1,49 @@
+"""The 4.0.4 repair payloads stay the files that runtime shipped."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / 'factory-overlay'
+LEGACY = json.loads((GUEST / 'tests/fixtures/omarchy-4.0.4/backports.json').read_text())
+
+
+def target(backport_id, path):
+    backport = next(b for b in LEGACY['backports'] if b['id'] == backport_id)
+    return next(t for t in backport['targets'] if t['path'] == path)
+
+
+class LegacyRepairPayloadTests(unittest.TestCase):
+    CASES = [
+        ('host-window-idle', 'shell/plugins/services/idle/Service.qml',
+         'usr/share/try-omarchy/host-window-idle.qml', 'usr/local/lib/try-omarchy/repair-host-window'),
+        ('clock-timezone-refresh', 'shell/plugins/panels/clock/BarWidget.qml',
+         'usr/share/try-omarchy/clock-timezone-refresh.qml', 'usr/local/lib/try-omarchy/repair-clock-timezone'),
+    ]
+
+    def test_payloads_are_the_patched_4_0_4_files(self):
+        for backport_id, path, payload, _ in self.CASES:
+            with self.subTest(payload=payload):
+                digest = hashlib.sha256((OVERLAY / payload).read_bytes()).hexdigest()
+                self.assertEqual(digest, target(backport_id, path)['afterSha256'])
+
+    def test_repairs_only_match_4_0_4_files(self):
+        spec = json.loads((GUEST / 'spec.json').read_text())
+        current = {t['afterSha256'] for b in spec['authenticity']['backports'] for t in b['targets']}
+        current |= {t['beforeSha256'] for b in spec['authenticity']['backports'] for t in b['targets']}
+        for backport_id, path, _, repair in self.CASES:
+            with self.subTest(repair=repair):
+                digests = set(re.findall(r'\b[0-9a-f]{64}\b', (OVERLAY / repair).read_text()))
+                self.assertTrue(digests)
+                self.assertTrue(digests.isdisjoint(current), digests & current)
+
+    def test_build_does_not_overwrite_the_frozen_payloads(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        for _, _, payload, _ in self.CASES:
+            self.assertNotIn(f'/{payload}\n', finalizer.replace(f'  {payload}\n', ''))
+
+
+if __name__ == '__main__':
+    unittest.main()
