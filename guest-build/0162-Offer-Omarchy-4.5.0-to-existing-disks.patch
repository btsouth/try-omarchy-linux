From cc1b0b237f7f02830ae962d666595bc768962078 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sun, 8 Nov 2026 00:54:18 -0500
Subject: [PATCH] Offer Omarchy 4.5.0 to existing disks

Compatibility revision 68 re-extracts the integration payload, so the next Update installs runtime 4.5.0-10 with the frozen 4.0.4 repair payloads in place.
---
 guest/scripts/finalize-rootfs.sh         | 4 +++-
 guest/tests/test_battery_details.py      | 2 +-
 guest/tests/test_clipboard_pull.py       | 2 +-
 guest/tests/test_compositor_health.py    | 2 +-
 guest/tests/test_display_output_scale.py | 2 +-
 guest/tests/test_guest_qol.py            | 2 +-
 guest/tests/test_live_update.py          | 2 +-
 guest/tests/test_native_nightlight.py    | 2 +-
 guest/tests/test_notification_privacy.py | 2 +-
 guest/tests/test_qt612_palette.py        | 2 +-
 guest/tests/test_snapper_guest.py        | 2 +-
 guest/tests/verify.py                    | 2 +-
 12 files changed, 14 insertions(+), 12 deletions(-)

diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 68ddc5f..6c7e3fe 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -294,7 +294,9 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 66 reports a slow compositor as busy while pacman runs.
 # Revision 67 removes the Foot-only xdg-terminal-exec so the default terminal
 # setting applies.
-compat_revision=67
+# Revision 68 offers the Omarchy 4.5.0 runtime and mise 2026.10.25, and keeps
+# the 4.0.4 idle and clock repairs on that runtime's files.
+compat_revision=68
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
diff --git a/guest/tests/test_battery_details.py b/guest/tests/test_battery_details.py
index 8dbe373..aed92d1 100644
--- a/guest/tests/test_battery_details.py
+++ b/guest/tests/test_battery_details.py
@@ -204,7 +204,7 @@ class BatteryDetailsFlowTests(unittest.TestCase):
     def test_compatibility_delivery_and_dkms_version(self):
         overlay = GUEST / "factory-overlay"
         finalize = (GUEST / "scripts/finalize-rootfs.sh").read_text()
-        self.assertIn("compat_revision=67", finalize)
+        self.assertIn("compat_revision=68", finalize)
         self.assertIn("usr/src/try-omarchy-battery-1.1.0", finalize)
         self.assertIn("usr/local/lib/try-omarchy/update-battery-dkms", finalize)
         self.assertIn('PACKAGE_VERSION="1.1.0"', (MODULE_SOURCE.parent / "dkms.conf").read_text())
