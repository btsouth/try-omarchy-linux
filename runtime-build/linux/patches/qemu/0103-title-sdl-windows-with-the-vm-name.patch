sdl2: title windows with the VM name alone

QEMU_SDL_TITLE_FROM_NAME=1 titles the first window with -name as given
("Try Omarchy") and further windows with the name and a 1-based number,
instead of "QEMU (name-0)". A launcher on Wayland cannot retitle another
process's window.

diff --git i/ui/sdl2.c w/ui/sdl2.c
index 4d9c87fff..a120bc7b1 100644
--- i/ui/sdl2.c
+++ w/ui/sdl2.c
@@ -201,7 +201,16 @@ static void sdl_update_caption(struct sdl2_console *scon)
         }
     }
 
-    if (qemu_name) {
+    if (qemu_name && g_strcmp0(g_getenv("QEMU_SDL_TITLE_FROM_NAME"), "1") == 0) {
+        /* An application running the VM names its windows after itself. */
+        if (scon->idx) {
+            snprintf(win_title, sizeof(win_title), "%s (%d)%s", qemu_name,
+                     scon->idx + 1, status);
+        } else {
+            snprintf(win_title, sizeof(win_title), "%s%s", qemu_name, status);
+        }
+        snprintf(icon_title, sizeof(icon_title), "%s", qemu_name);
+    } else if (qemu_name) {
         snprintf(win_title, sizeof(win_title), "QEMU (%s-%d)%s", qemu_name,
                  scon->idx, status);
         snprintf(icon_title, sizeof(icon_title), "QEMU (%s)", qemu_name);
