--- a/ui/sdl2.c
+++ b/ui/sdl2.c
@@ -817,6 +817,26 @@
         }
     }
 
+    /* Renew even without window events, including after a QMP reconnect.
+     * Occlusion and workspace visibility are not exposed portably by SDL. */
+    if (qemu_console_get_index(scon->dcl.con) == 0) {
+        static uint64_t last_report;
+        static bool last_visible;
+        static bool reported;
+        uint64_t now = SDL_GetTicks64();
+        uint32_t flags = scon->real_window ?
+            SDL_GetWindowFlags(scon->real_window) : 0;
+        bool visible = (flags & SDL_WINDOW_SHOWN) &&
+            !(flags & (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED));
+
+        if (!reported || visible != last_visible || now - last_report >= 5000) {
+            qapi_event_send_display_visibility(0, visible);
+            last_report = now;
+            last_visible = visible;
+            reported = true;
+        }
+    }
+
     if (idle) {
         if (scon->idle_counter < SDL2_MAX_IDLE_COUNT) {
             scon->idle_counter++;
--- a/qapi/ui.json
