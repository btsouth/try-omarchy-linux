+/* Called with the PipeWire thread loop locked, outside the RT callback. */
+static int qpw_stream_connect(PWVoice *v)
+{
+    uint8_t buffer[1024];
+    struct spa_pod_builder b = SPA_POD_BUILDER_INIT(buffer, sizeof(buffer));
+    const struct spa_pod *params[] = {
+        spa_format_audio_raw_build(&b, SPA_PARAM_EnumFormat, &v->info)
+    };
+
+    return pw_stream_connect(v->stream,
+        v->direction == SPA_DIRECTION_INPUT ? PW_DIRECTION_INPUT :
+                                             PW_DIRECTION_OUTPUT,
+        PW_ID_ANY, PW_STREAM_FLAG_AUTOCONNECT | PW_STREAM_FLAG_INACTIVE |
+        PW_STREAM_FLAG_MAP_BUFFERS | PW_STREAM_FLAG_RT_PROCESS, params, 1);
+}
+
+static int qpw_stream_create(AudioPw *c, PWVoice *v, const char *stream_name,
+                             const char *name, enum spa_direction dir);
+
+static int qpw_stream_retarget(AudioPw *c, PWVoice *v, const char *name)
+{
+    AudiodevPipewireOptions *opts = &AUDIO_MIXENG_BACKEND(c)->dev->u.pipewire;
+    AudiodevPipewirePerDirectionOptions *direction =
+        v->direction == SPA_DIRECTION_INPUT ? opts->in : opts->out;
+    const struct pw_stream_control *control;
+    int res;
+
+    if (v->stream) {
+        control = pw_stream_get_control(v->stream, SPA_PROP_channelVolumes);
+        if (control && control->n_values <= SPA_AUDIO_MAX_CHANNELS) {
+            v->volume.channels = control->n_values;
+            memcpy(v->volume.values, control->values,
+                   control->n_values * sizeof(float));
+        }
+        control = pw_stream_get_control(v->stream, SPA_PROP_mute);
+        if (control && control->n_values) {
+            v->muted = control->values[0] != 0.f;
+        }
+    }
+    /* A fresh node avoids retaining the previous graph's clock on reconnect. */
+    if (v->stream) {
+        pw_stream_destroy(v->stream);
+    }
+    spa_ringbuffer_init(&v->ring);
+    res = qpw_stream_create(c, v,
+        direction->stream_name ?: AUDIO_MIXENG_BACKEND(c)->dev->id,
+        name, v->direction);
+    if (res < 0) {
+        return res;
+    }
+    if (v->volume.channels) {
+        float mute = v->muted ? 1.f : 0.f;
+        pw_stream_set_control(v->stream, SPA_PROP_channelVolumes,
+                              v->volume.channels, v->volume.values, 0);
+        pw_stream_set_control(v->stream, SPA_PROP_mute, 1, &mute, 0);
+    }
+    return pw_stream_set_active(v->stream, v->enabled);
+}
+
+/* Only this backend's streams change. Host defaults and other clients stay put. */
+static void qpw_set_target(Object *obj, const char *name, Error **errp,
+                           bool capture)
+{
+    AudioPw *c = AUDIO_PW(obj);
+    AudiodevPipewireOptions *opts = &AUDIO_MIXENG_BACKEND(c)->dev->u.pipewire;
+    AudiodevPipewirePerDirectionOptions *direction = capture ? opts->in : opts->out;
+    const char *target = *name ? name : NULL;
+    PWVoice *v;
+    int res = 0;
+
+    if (strlen(name) > 4096 || !g_utf8_validate(name, -1, NULL)) {
+        error_setg(errp, "Invalid PipeWire target name");
+        return;
+    }
+    if (!g_strcmp0(direction->name, target)) {
+        return;
+    }
+    pw_thread_loop_lock(c->thread_loop);
+    QLIST_FOREACH(v, &c->voices, next) {
+        if ((v->direction == SPA_DIRECTION_INPUT) != capture) {
+            continue;
+        }
+        res = qpw_stream_retarget(c, v, target);
+        if (res < 0) {
+            break;
+        }
+    }
+    if (res < 0) {
+        /* Restore every voice, including one whose reconnect failed. */
+        QLIST_FOREACH(v, &c->voices, next) {
+            if ((v->direction == SPA_DIRECTION_INPUT) == capture &&
+                qpw_stream_retarget(c, v, direction->name) < 0) {
+                error_report("pipewire: failed to restore the previous route");
+            }
+        }
+        error_setg(errp, "Could not change PipeWire route: %s", spa_strerror(res));
+    } else {
+        g_free(direction->name);
+        direction->name = g_strdup(target);
+    }
+    pw_thread_loop_unlock(c->thread_loop);
+}
+
+static void qpw_set_output(Object *obj, const char *name, Error **errp)
+{
+    qpw_set_target(obj, name, errp, false);
+}
+
+static void qpw_set_input(Object *obj, const char *name, Error **errp)
+{
+    qpw_set_target(obj, name, errp, true);
+}
+
+static char *qpw_get_output(Object *obj, Error **errp)
+{
+    return g_strdup(AUDIO_MIXENG_BACKEND(obj)->dev->u.pipewire.out->name ?: "");
+}
+
+static char *qpw_get_input(Object *obj, Error **errp)
+{
+    return g_strdup(AUDIO_MIXENG_BACKEND(obj)->dev->u.pipewire.in->name ?: "");
+}
