+# @width: Window width in the same coordinates, sent with @x.
+#
+# @height: Window height in the same coordinates, sent with @y.
+#
 # Since: 11.0
 ##
 { 'event': 'DISPLAY_FILE_DROP',
-  'data': { 'display': 'int', 'files': [ 'str' ] } }
