+
+##
+# @DISPLAY_DROP_POINTER_MOVED:
+#
+# The pointer moved away from the position reported with the last
+# DISPLAY_FILE_DROP, or left the window, within 30 seconds of the
+# drop.  Sent at most once per drop.
+#
+# @display: QEMU console index that received the drop.
+#
+# Since: 11.1
+##
+{ 'event': 'DISPLAY_DROP_POINTER_MOVED',
+  'data': { 'display': 'int' } }
 
 ##
 # @DISPLAY_CLOSE_REQUEST:
