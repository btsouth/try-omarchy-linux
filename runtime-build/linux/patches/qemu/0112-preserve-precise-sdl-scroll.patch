+static void sdl_send_wheel_buttons(struct sdl2_console *scon, int value,
+                                   InputButton positive, InputButton negative)
+{
+    InputButton button = value > 0 ? positive : negative;
+
+    for (int64_t i = 0; i < llabs((int64_t)value); i++) {
+        qemu_input_queue_btn(scon->dcl.con, button, true);
+        qemu_input_event_sync();
+        qemu_input_queue_btn(scon->dcl.con, button, false);
+        qemu_input_event_sync();
+    }
+}
