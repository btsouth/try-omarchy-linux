+bool qemu_input_has_wheel(QemuConsole *con)
+{
+    QemuInputHandlerState *s = qemu_input_find_handler(INPUT_EVENT_MASK_BTN, con);
+
+    return s && (s->handler->mask & INPUT_EVENT_MASK_WHEEL);
+}
+
+static uint32_t qemu_input_event_mask(InputEventKind kind, InputAxis axis)
+{
+    if (kind == INPUT_EVENT_KIND_REL &&
+        (axis == INPUT_AXIS_WHEEL || axis == INPUT_AXIS_HWHEEL)) {
+        return INPUT_EVENT_MASK_WHEEL;
+    }
+    return 1 << kind;
+}
