new file mode 100644
index 0000000..b5a7a0a
--- /dev/null
+++ b/include/ui/sdl2-scroll.h
@@ -0,0 +1,37 @@
+/* SDL wheel conversion, independent of SDL for testing.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_SDL2_SCROLL_H
+#define QEMU_SDL2_SCROLL_H
+
+#include <limits.h>
+#include <math.h>
+#include <stdint.h>
+
+typedef struct SDLScroll {
+    double x, y;
+    int64_t legacy_x, legacy_y;
+} SDLScroll;
+
+/* SDL units are detents, including fractional Windows WHEEL_DELTA / 120.
+ * Retain fractions of a Linux hi-res unit between frames.
+ */
+static inline int sdl_scroll_axis(double delta, double *remainder)
+{
+    double total = delta * 120.0 + *remainder;
+    int value;
+
+    if (!isfinite(total)) {
+        *remainder = 0.0;
+        return 0;
+    }
+    if (total >= INT_MAX || total <= INT_MIN) {
+        *remainder = 0.0;
+        return total >= INT_MAX ? INT_MAX : INT_MIN;
+    }
+    value = (int)total;
+    *remainder = total - value;
+    return value;
+}
+
+#endif
