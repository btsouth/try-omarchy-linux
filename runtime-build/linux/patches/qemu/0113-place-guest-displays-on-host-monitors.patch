+/* SDL reports host hotplug independently of guest scanouts. Keep the VM and
+ * every window alive, exit fullscreen on a missing monitor, and retain the
+ * connector for replug. Re-enter fullscreen only when the user asks. */
+static void sdl_host_displays_changed(void)
+{
+    int i;
+    for (i = 0; i < sdl2_num_outputs; i++) {
+        struct sdl2_console *scon = &sdl2_console[i];
+        int display = sdl_target_display(scon);
+        if (!scon->real_window) {
+            continue;
+        }
+        if (display < 0) {
+            if (scon->fullscreen && sdl_set_fullscreen(scon, false)) {
+                if (SDL_GetWindowFlags(scon->real_window) & SDL_WINDOW_INPUT_FOCUS) {
+                    sdl_grab_end(scon);
+                    SDL_SetWindowMouseGrab(scon->real_window, SDL_FALSE);
+                }
+            }
+            SDL_SetWindowPosition(scon->real_window,
+                                 SDL_WINDOWPOS_CENTERED_DISPLAY(0),
+                                 SDL_WINDOWPOS_CENTERED_DISPLAY(0));
+        } else if (scon->fullscreen) {
+            /* Reordered SDL indices still refer to the saved connector. */
+            sdl_set_fullscreen(scon, true);
+        }
+    }
 }
 
