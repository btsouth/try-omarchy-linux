+/* Names vary by backend: Wayland SDL names may be wl_output descriptions,
+ * while GTK supplies connectors. Logical bounds align the two monitor lists. */
+static int sdl_target_display(struct sdl2_console *scon)
+{
+    int count = SDL_GetNumVideoDisplays();
+    int i;
+
+    if (scon->target_monitor && *scon->target_monitor) {
+        for (i = 0; i < count; i++) {
+            const char *name = SDL_GetDisplayName(i);
+            if (name && *name && !strcmp(name, scon->target_monitor)) {
+                return i;
+            }
+        }
+    }
+    if (scon->has_target_bounds) {
+        for (i = 0; i < count; i++) {
+            SDL_Rect b;
+            if (SDL_GetDisplayBounds(i, &b) == 0 &&
+                b.x == scon->target_bounds.x && b.y == scon->target_bounds.y &&
+                b.w == scon->target_bounds.w && b.h == scon->target_bounds.h) {
+                return i;
+            }
+        }
+    }
+    if (scon->target_monitor || scon->has_target_bounds) {
+        return -1;
+    }
+    return count > 0 ? scon->idx % count : -1;
+}
+
+/* Automatic without GTK still pins a bounds identity. Empty or duplicate
+ * display names must never collapse distinct outputs onto the first match. */
+static void sdl_pin_output(struct sdl2_console *scon, int display)
+{
+    const char *name;
+    int i, count;
+
+    if (display < 0 || scon->target_monitor || scon->has_target_bounds) {
+        return;
+    }
+    scon->has_target_bounds = SDL_GetDisplayBounds(display, &scon->target_bounds) == 0;
+    name = SDL_GetDisplayName(display);
+    if (!name || !*name) {
+        return;
+    }
+    count = SDL_GetNumVideoDisplays();
+    for (i = 0; i < count; i++) {
+        if (i != display && g_strcmp0(SDL_GetDisplayName(i), name) == 0) {
+            return;
+        }
+    }
+    scon->target_monitor = g_strdup(name);
+}
+
+static bool sdl_display_available(struct sdl2_console *scon, int display)
+{
+    int i;
+
+    if (display < 0) {
+        return false;
+    }
+    for (i = 0; i < sdl2_num_outputs; i++) {
+        struct sdl2_console *other = &sdl2_console[i];
+        if (other != scon && other->real_window && other->fullscreen &&
+            sdl_target_display(other) == display) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* Set pending display position before fullscreen: SDL3 also uses it for
+ * xdg_toplevel.set_fullscreen(output) on Wayland, where windowed placement
+ * belongs to the compositor. Use CENTERED: SDL3 discards UNDEFINED display
+ * bits in SetWindowPosition, but CENTERED sets pending_displayID.
+ * X11 uses the target display's bounds.
+ */
+static bool sdl_set_fullscreen(struct sdl2_console *scon, bool fullscreen)
+{
+    int display = sdl_target_display(scon);
+
+    if (!scon->real_window ||
+        (fullscreen && !sdl_display_available(scon, display))) {
+        return false;
+    }
+    if (fullscreen) {
+        SDL_SetWindowPosition(scon->real_window,
+                             SDL_WINDOWPOS_CENTERED_DISPLAY(display),
+                             SDL_WINDOWPOS_CENTERED_DISPLAY(display));
+    }
+    if (SDL_SetWindowFullscreen(scon->real_window,
+            fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0) < 0) {
+        return false;
+    }
+    scon->fullscreen = fullscreen;
+    return true;
+}
+
+static void sdl_configure_output(struct sdl2_console *scon)
+{
+    g_autofree char *key = g_strdup_printf("QEMU_SDL_OUTPUT_%d", scon->idx);
+    const char *name = g_getenv(key);
+    g_autofree char *fskey = g_strdup_printf("QEMU_SDL_OUTPUT_FULLSCREEN_%d",
+                                            scon->idx);
+    const char *fullscreen = g_getenv(fskey);
+    g_autofree char *boundskey = g_strdup_printf("QEMU_SDL_OUTPUT_BOUNDS_%d",
+                                                scon->idx);
+    const char *bounds = g_getenv(boundskey);
+
+    scon->has_target_bounds = false;
+    if (bounds) {
+        int values[4], i;
+        const char *next = bounds;
+        for (i = 0; i < 4; i++) {
+            char *end;
+            int64_t value;
+            if (!g_ascii_isdigit(*next) && *next != '-') {
+                break;
+            }
+            value = g_ascii_strtoll(next, &end, 10);
+            if (end == next || value < (i < 2 ? -1048576 : 1) ||
+                value > (i < 2 ? 1048576 : 32768) ||
+                (i < 3 ? *end != ',' : *end != '\0')) {
+                break;
+            }
+            values[i] = value;
+            next = end + (i < 3);
+        }
+        if (i != 4) {
+            error_report("Invalid SDL output bounds for console %d", scon->idx);
+            exit(1);
+        }
+        scon->target_bounds = (SDL_Rect) {values[0], values[1], values[2], values[3]};
+        scon->has_target_bounds = true;
+    }
+
+    /* Reject malformed launch environments rather than silently misroute. */
+    if (name && (strlen(name) > 64 || strpbrk(name, ",\r\n"))) {
+        error_report("Invalid SDL output monitor for console %d", scon->idx);
+        exit(1);
+    }
+    if (fullscreen && strcmp(fullscreen, "true") && strcmp(fullscreen, "false")) {
+        error_report("Invalid SDL output fullscreen for console %d", scon->idx);
+        exit(1);
+    }
+    scon->target_monitor = name && *name ? g_strdup(name) : NULL;
+    scon->fullscreen_requested = fullscreen ? !strcmp(fullscreen, "true") :
+                                              initial_fullscreen;
+}
