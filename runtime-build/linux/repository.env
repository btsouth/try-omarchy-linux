# The public Flatpak repository. publish-repo.sh writes these into the
# repository summary, the .flatpakref and the bundle. flatpak.tryomarchy.com is
# the Cloudflare Pages project PAGES_PROJECT, which deploy-repo.sh uploads to.
# Hosting can move without changing the address installed copies update from.
# tryomarchy.com serves a copy of the .flatpakref as /linux.flatpakref; keep it
# identical.
SITE_URL=https://flatpak.tryomarchy.com/
REPO_URL=https://flatpak.tryomarchy.com/repo/
RUNTIME_REPO=https://dl.flathub.org/repo/flathub.flatpakrepo
REMOTE_NAME=try-omarchy
BRANCH=stable
TITLE='Try Omarchy'
COMMENT='Try the Omarchy desktop in a window'
HOMEPAGE=https://tryomarchy.com/linux/
PAGES_PROJECT=try-omarchy-flatpak
GITHUB_REPO=btsouth/try-omarchy-linux
