--- a/src/virtio/vulkan/vn_wsi.c
+++ b/src/virtio/vulkan/vn_wsi.c
@@ -187,6 +187,16 @@
       return result;
 
    physical_dev->wsi_device.supports_scanout = false;
+
+   /* The prime buffer reaches the host compositor as a LINEAR dma-buf, which
+    * virglrenderer binds with glEGLImageTargetTexStorageEXT. Nvidia's GL
+    * then reads it at a row pitch of align(width * cpp, 32), ignoring the
+    * imported pitch, so the default 256-byte alignment shears every frame
+    * whose row is not already a multiple of 256 bytes. Align to exactly 32.
+    */
+   if (physical_dev->renderer_driver_id == VK_DRIVER_ID_NVIDIA_PROPRIETARY)
+      physical_dev->wsi_device.prime_linear_stride_align = 32;
+
    physical_dev->wsi_device.supports_modifiers =
       physical_dev->base.vk.supported_extensions.EXT_image_drm_format_modifier;
    physical_dev->base.vk.wsi_device = &physical_dev->wsi_device;
